# Stream Command Center - Environment Configuration
APP_SECRET=replace-with-a-long-random-secret

# MongoDB Configuration (Optional - without MONGODB_URI, Stream Command Center automatically uses built-in zero-config storage)
# For persistent cross-instance database storage on Vercel or cloud, add your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=stream_command_center

# YouTube OAuth & API (Optional - required for YouTube channel live chat reply & video publication)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitch OAuth & API (Optional - required for Twitch channel live chat reply & video publication)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# =========================================================================
# Stream Command Center - Environment Configuration
# =========================================================================

# App Security Secret (Used for HMAC session signatures & AES-256 token encryption)
APP_SECRET=replace-with-a-long-random-secret-64-chars-recommended

# Server Port (Default: 4173)
PORT=4173

# -------------------------------------------------------------------------
# Database Storage (Optional)
# If omitted, Stream Command Center uses built-in AES-encrypted local storage.
# For production or cloud deployments (Vercel, Railway, VPS):
# -------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=stream_command_center

# -------------------------------------------------------------------------
# 1. YouTube Live OAuth 2.0 (Google Cloud Console)
# Redirect URI: http://localhost:4173/auth/youtube/callback
# Production:   https://your-domain.vercel.app/auth/youtube/callback
# Scopes:       https://www.googleapis.com/auth/youtube.force-ssl
# -------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# -------------------------------------------------------------------------
# 2. Twitch OAuth 2.0 (Twitch Developer Console)
# Redirect URI: http://localhost:4173/auth/twitch/callback
# Production:   https://your-domain.vercel.app/auth/twitch/callback
# Scopes:       user:read:chat user:write:chat chat:read chat:edit
# -------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# -------------------------------------------------------------------------
# 3. Facebook Live OAuth 2.0 (Meta for Developers)
# Redirect URI: http://localhost:4173/auth/facebook/callback
# Production:   https://your-domain.vercel.app/auth/facebook/callback
# Scopes:       pages_show_list,pages_read_engagement,pages_manage_posts
# -------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -------------------------------------------------------------------------
# 4. Kick Live Stream Chat (Pusher WebSocket Gateway)
# No API keys or OAuth credentials required!
# Kick live stream chat connects directly via public Pusher protocol.
# -------------------------------------------------------------------------
